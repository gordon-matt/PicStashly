{
  "SeedAdmin": {
    "Email": "admin@picstashly.local"
    // "Password": "Admin@123"   ← override here or via SeedAdmin__Password env var
  },
  "Database": {
    // Database engine to use. One of: "Sqlite" (default), "Npgsql" (PostgreSQL), "SqlServer", "MySql".
    // The connection string is always read from ConnectionStrings:DefaultConnection and must match
    // the selected provider. Override via env var Database__Provider (e.g. in Docker).
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=picstashly.db"
  },
  "FileStorage": {
    // Root folder for stored images and thumbnails. Defaults to "<app folder>/uploads" when empty.
    // In Docker, mount a volume here (e.g. "/app/data").
    "BasePath": null
  },
  "ImageProcessing": {
    // When true, uploaded images larger than MaxWidth x MaxHeight are downscaled to fit
    // (aspect ratio preserved, original format kept). Images within limits are stored untouched.
    "AutoShrinkImages": true,
    "MaxWidth": 1920,
    "MaxHeight": 1920,
    // Encoder quality used when an image has to be re-encoded (i.e. it was downscaled).
    "Quality": 85,
    "ThumbnailWidth": 400,
    "ThumbnailHeight": 400,
    "ThumbnailQuality": 75
  },
  "Upload": {
    "AllowedExtensions": ".jpg,.jpeg,.png,.gif,.webp,.bmp",
    "MaxFileSizeBytes": 52428800,
    // Maximum pHash Hamming distance (0-64) for two images to be flagged as near-duplicates
    // on upload. 0 = only byte-identical-looking images; 5 is a good default; higher values
    // catch more edits/crops but risk false positives.
    "DuplicateHammingThreshold": 5
  },
  "Ocr": {
    // Extracts text baked into images (meme captions etc.) so it becomes searchable.
    // Requires the tesseract CLI: https://github.com/tesseract-ocr/tesseract
    // (Windows: winget install tesseract-ocr.tesseract / installer; Linux: apt install tesseract-ocr).
    // When tesseract is not installed, OCR is skipped gracefully and everything else still works.
    "Enabled": true,
    "TesseractPath": "tesseract",
    "Languages": "eng",
    "TimeoutSeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"

  // ── Optional: Keycloak authentication ──────────────────────────────────────
  // By default the app uses built-in ASP.NET Core Identity (local user database) — a single
  // default admin account (see SeedAdmin above) is created on first run. To use Keycloak
  // instead, uncomment the block below and fill in your values. See docs/KEYCLOAK_SETUP.md
  // for step-by-step Keycloak configuration instructions.
  //
  // "Authentication": {
  //   "Provider": "Keycloak",
  //   "Keycloak": {
  //     // Authority: public Keycloak realm URL — used by the browser for login AND by the
  //     // app container for backchannel calls (discovery, token exchange).
  //     // The container must be able to reach this URL; use extra_hosts in docker-compose
  //     // when Keycloak is in a separate stack behind a reverse proxy (see docker-compose.yml).
  //     // Format: http(s)://<host>:<port>/realms/<realm-name>
  //     "Authority": "http://localhost:8081/realms/picstashly",
  //
  //     // ClientId must match the client you created in Keycloak.
  //     "ClientId": "picstashly",
  //
  //     // ClientSecret: copy from Keycloak → Clients → picstashly → Credentials tab.
  //     // Never commit this value. Use User Secrets (dev) or an environment variable (prod).
  //     "ClientSecret": "replace-with-your-client-secret"
  //
  //     // Optional: set to the app's public HTTPS URL (e.g. https://picstashly.example.com) when the
  //     // reverse proxy does not forward X-Forwarded-Proto and the app sends http:// in redirect_uri.
  //     // Not needed if forwarded headers are working correctly.
  //     // "PublicOrigin": "https://picstashly.example.com",
  //
  //     // Optional: when the app container cannot reach the public Keycloak hostname (e.g.
  //     // Docker hairpin NAT), set this to the internal URL where the container can reach
  //     // Keycloak directly. All backchannel calls (discovery, token exchange) are rerouted
  //     // there while Authority stays public for browser-facing login redirects.
  //     // Example (same Docker network, using container name): "http://keycloak:8080"
  //     // "BackchannelBaseUrl": "http://keycloak:8080"
  //   }
  // }
}
