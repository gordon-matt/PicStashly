@{
    ViewData["Title"] = "Library";
}

<div class="container-fluid">
    <!-- Sticky filter bar -->
    <div class="filter-bar">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-2">
                <input type="text" class="form-control" placeholder="Search filename, tags, text..."
                       data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
            </div>
            <div class="col-12 col-md-2">
                <input id="tagFilterInput" class="form-control" placeholder="Filter by tags..." />
            </div>
            <div class="col-6 col-md-2">
                <select class="form-select" data-bind="value: categoryFilter, options: categories, optionsText: 'name', optionsValue: 'id', optionsCaption: 'All categories'">
                </select>
            </div>
            <div class="col-6 col-md-2">
                <select class="form-select" data-bind="value: sort">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="random">Random shuffle</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="untaggedToggle" data-bind="checked: untaggedOnly" />
                    <label class="form-check-label" for="untaggedToggle">Untagged only</label>
                </div>
            </div>
            <div class="col-6 col-md-2 d-flex gap-2 justify-content-md-end">
                <button class="btn btn-outline-secondary" data-bind="click: clearFilters" title="Clear filters">
                    <i class="bi bi-x-circle"></i>
                </button>
                <button class="btn"
                        data-bind="click: toggleSelectionMode,
                                   css: selectionMode() ? 'btn-primary' : 'btn-outline-secondary'"
                        title="Select multiple images for bulk tagging">
                    <i class="bi bi-check2-square"></i>
                </button>
                <a href="/upload" class="btn btn-primary text-nowrap">
                    <i class="bi bi-cloud-arrow-up"></i> Upload
                </a>
            </div>
        </div>

        <!-- Bulk action bar (visible in selection mode) -->
        <div class="row g-2 mt-1 align-items-center" data-bind="visible: selectionMode" style="display: none;">
            <div class="col-auto">
                <span class="badge bg-primary" data-bind="text: selectedIds().length + ' selected'"></span>
            </div>
            <div class="col-12 col-md-4">
                <input id="bulkTagsInput" class="form-control form-control-sm" placeholder="Tags to apply/remove..." />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-success" data-bind="click: applyBulkTags, enable: canBulkTag">
                    <i class="bi bi-plus-lg"></i> Apply tags
                </button>
                <button class="btn btn-sm btn-outline-danger" data-bind="click: removeBulkTags, enable: canBulkTag">
                    <i class="bi bi-dash-lg"></i> Remove tags
                </button>
                <button class="btn btn-sm btn-outline-secondary" data-bind="click: selectAllVisible">
                    Select all
                </button>
                <button class="btn btn-sm btn-outline-secondary" data-bind="click: clearSelection">
                    Clear
                </button>
            </div>
        </div>
    </div>

    <!-- Empty / no-results state -->
    <div data-bind="visible: !loading() && images().length === 0" class="alert alert-info" style="display: none;">
        <i class="bi bi-info-circle me-2"></i>
        <span data-bind="visible: hasActiveFilters">No images match the current filters — try removing some.</span>
        <span data-bind="visible: !hasActiveFilters()">
            Your library is empty. <a href="/upload">Upload some images</a> to get started.
        </span>
    </div>

    <!-- Masonry grid -->
    <div class="masonry-grid" data-bind="foreach: images">
        <div class="masonry-item"
             data-bind="click: $parent.onItemClick, css: { selected: $parent.isSelected($data) }">
            <input type="checkbox" class="form-check-input select-check"
                   data-bind="visible: $parent.selectionMode, checked: $parent.isSelected($data),
                              event: { click: function (d, e) { e.stopPropagation(); $parent.toggleSelected($data); return true; } }" />
            <button type="button" class="btn btn-sm btn-secondary item-copy" title="Copy image"
                    data-bind="visible: !$parent.selectionMode(),
                               event: { click: function (d, e) { e.stopPropagation(); $parent.copyItemImage($data); return true; } }">
                <i class="bi bi-clipboard"></i>
            </button>
            <button type="button" class="btn btn-sm btn-secondary item-edit-tags" title="Edit tags"
                    data-bind="visible: !$parent.selectionMode(),
                               event: { click: function (d, e) { e.stopPropagation(); $parent.editItemTags($data); return true; } }">
                <i class="bi bi-pencil"></i>
            </button>
            <button type="button" class="btn btn-sm btn-danger item-delete" title="Delete"
                    data-bind="visible: !$parent.selectionMode(),
                               event: { click: function (d, e) { e.stopPropagation(); $parent.deleteItem($data); return true; } }">
                <i class="bi bi-trash"></i>
            </button>
            <img loading="lazy" data-bind="attr: { src: thumbnailUrl, alt: fileName }" />
            <div class="item-tags">
                <!-- ko foreach: tags -->
                <span class="badge rounded-pill bg-dark border me-1 mb-1" data-bind="text: $data"></span>
                <!-- /ko -->
            </div>
        </div>
    </div>

    <!-- Infinite scroll sentinel + spinner -->
    <div id="scrollSentinel"></div>
    <div data-bind="visible: loading" class="text-center py-4">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
    <div data-bind="visible: !loading() && !hasMore() && images().length > 0" class="text-center text-muted py-3">
        <span data-bind="text: totalCount() + ' image(s)'"></span>
    </div>
</div>

<!-- Lightbox -->
<div class="lightbox-backdrop" data-bind="visible: lightboxImage() !== null" style="display: none;">
    <!-- ko with: lightboxImage -->
    <div class="lightbox-nav prev" data-bind="click: $parent.lightboxPrev"><i class="bi bi-chevron-left"></i></div>
    <div class="lightbox-nav next" data-bind="click: $parent.lightboxNext"><i class="bi bi-chevron-right"></i></div>

    <div class="lightbox-image-wrap" data-bind="click: $parent.closeLightbox">
        <img data-bind="attr: { src: url, alt: fileName }, event: { click: function (d, e) { e.stopPropagation(); } }" />
    </div>

    <div class="lightbox-toolbar">
        <input id="lightboxTagsInput" class="form-control form-control-sm lightbox-tags-input" placeholder="Tags... (press t to focus)" />
        <select class="form-select form-select-sm lightbox-category-select"
                data-bind="value: categoryId, options: $parent.categories, optionsText: 'name', optionsValue: 'id', optionsCaption: 'No category',
                           event: { change: function () { $parent.changeLightboxCategory(); return true; } }">
        </select>
        <span class="text-light small flex-grow-1 text-truncate" data-bind="text: fileName"></span>
        <a class="btn btn-sm btn-outline-light" data-bind="attr: { href: '/image/' + id }" title="Details">
            <i class="bi bi-info-circle"></i>
        </a>
        <button class="btn btn-sm btn-outline-light" data-bind="click: $parent.copyLightboxImage" title="Copy image to clipboard">
            <i class="bi bi-clipboard"></i>
        </button>
        <a class="btn btn-sm btn-outline-light" data-bind="attr: { href: url, download: fileName }" title="Download">
            <i class="bi bi-download"></i>
        </a>
        <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteLightboxImage" title="Delete (Del)">
            <i class="bi bi-trash"></i>
        </button>
        <button class="btn btn-sm btn-outline-light" data-bind="click: $parent.closeLightbox" title="Close (Esc)">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <!-- /ko -->
</div>

@section Scripts {
    <script type="module" src="~/js/library.js" asp-append-version="true"></script>
}
