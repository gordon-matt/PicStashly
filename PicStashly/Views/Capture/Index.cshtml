@{
    ViewData["Title"] = "Capture";
}

<div class="container" style="max-width: 640px;">
    <h2 class="mb-3">Stash it!</h2>

    <div class="card mb-3">
        <img class="card-img-top upload-card-thumb" style="height: 240px;" data-bind="attr: { src: imageUrl }" />
        <div class="card-body">
            <p class="small text-muted text-break mb-1" data-bind="text: imageUrl"></p>

            <div class="mb-3">
                <input id="captureTagsInput" class="form-control" placeholder="Tags..." />
            </div>

            <div data-bind="visible: status() === 'idle'">
                <button class="btn btn-primary" data-bind="click: save">
                    <i class="bi bi-cloud-arrow-up"></i> Save to library
                </button>
            </div>

            <div data-bind="visible: status() === 'saving'" class="text-muted" style="display: none;">
                <span class="spinner-border spinner-border-sm"></span> Saving...
            </div>

            <div data-bind="visible: status() === 'saved'" style="display: none;">
                <div class="alert alert-success py-2">
                    <i class="bi bi-check-circle me-1"></i> Saved!
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold d-flex justify-content-between align-items-center">
                        Extracted text (OCR)
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-bind="click: saveOcrText, enable: ocrTextDirty">
                            <i class="bi bi-save"></i> Save
                        </button>
                    </label>
                    <textarea class="form-control" rows="4"
                              placeholder="No text extracted — correct or add it here to make the image searchable"
                              data-bind="value: ocrText, valueUpdate: 'afterkeydown'"></textarea>
                </div>

                <a class="btn btn-outline-primary" data-bind="attr: { href: '/image/' + savedId() }">View image</a>
            </div>

            <div data-bind="visible: status() === 'duplicate'" style="display: none;">
                <div class="alert alert-warning py-2">
                    <i class="bi bi-exclamation-triangle me-1"></i> You already have something similar:
                </div>
                <div class="d-flex flex-wrap gap-2 mb-2" data-bind="foreach: duplicates">
                    <a data-bind="attr: { href: '/image/' + id, title: fileName }" target="_blank">
                        <img class="dedup-thumb" data-bind="attr: { src: thumbnailUrl }" />
                    </a>
                </div>
                <button class="btn btn-primary" data-bind="click: saveAnyway">Save anyway</button>
            </div>

            <div data-bind="visible: status() === 'error'" style="display: none;">
                <div class="alert alert-danger py-2">
                    <i class="bi bi-x-circle me-1"></i> <span data-bind="text: errorMessage"></span>
                </div>
                <button class="btn btn-outline-primary" data-bind="click: save">Retry</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const captureImageUrl = @Json.Serialize((string)ViewBag.ImageUrl);
        const capturePageUrl = @Json.Serialize((string?)ViewBag.PageUrl);
    </script>
    <script type="module" src="~/js/capture.js" asp-append-version="true"></script>
}
