@{
    ViewData["Title"] = "Categories";
}

<div class="container">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h2>Categories</h2>
            <p class="text-muted mb-0">Create, rename or delete categories used to organize images</p>
        </div>
    </div>

    <!-- New category -->
    <div class="row g-2 mb-4 align-items-center">
        <div class="col-auto">
            <label for="newCategoryInput" class="col-form-label">New category:</label>
        </div>
        <div class="col-12 col-md-4">
            <input id="newCategoryInput" class="form-control" placeholder="Category name..."
                   data-bind="value: newCategoryName, valueUpdate: 'afterkeydown',
                              event: { keyup: function (d, e) { if (e.key === 'Enter') createCategory(); return true; } }" />
        </div>
        <div class="col-auto">
            <button class="btn btn-success" data-bind="click: createCategory, enable: newCategoryName().trim().length > 0">
                <i class="bi bi-plus-lg"></i> Add
            </button>
        </div>
    </div>

    <div data-bind="visible: loading" class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div data-bind="visible: !loading() && categories().length === 0" class="alert alert-info" style="display: none;">
        <i class="bi bi-info-circle me-2"></i> No categories yet — create one above to start organizing your images.
    </div>

    <table class="table table-hover align-middle" data-bind="visible: !loading() && categories().length > 0" style="display: none;">
        <thead>
            <tr>
                <th>Name</th>
                <th class="text-end">Images</th>
                <th class="text-end" style="width: 160px;">Actions</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: categories">
            <tr>
                <td>
                    <!-- ko ifnot: $parent.editingCategory() === $data -->
                    <a data-bind="text: name, attr: { href: '/?categoryId=' + id }"></a>
                    <!-- /ko -->
                    <!-- ko if: $parent.editingCategory() === $data -->
                    <input type="text" class="form-control form-control-sm d-inline-block w-auto"
                           data-bind="value: $parent.editName, valueUpdate: 'afterkeydown',
                                      event: { keyup: function (d, e) { if (e.key === 'Enter') $parent.saveRename(); if (e.key === 'Escape') $parent.cancelRename(); return true; } }" />
                    <!-- /ko -->
                </td>
                <td class="text-end" data-bind="text: imageCount"></td>
                <td class="text-end">
                    <!-- ko ifnot: $parent.editingCategory() === $data -->
                    <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.startRename" title="Rename">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteCategory" title="Delete">
                        <i class="bi bi-trash"></i>
                    </button>
                    <!-- /ko -->
                    <!-- ko if: $parent.editingCategory() === $data -->
                    <button class="btn btn-sm btn-success" data-bind="click: $parent.saveRename" title="Save">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.cancelRename" title="Cancel">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <!-- /ko -->
                </td>
            </tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script type="module" src="~/js/categories.js" asp-append-version="true"></script>
}
