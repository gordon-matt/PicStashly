@using System.Security.Claims
@using PicStashly.Infrastructure
@inject IAuthProviderService AuthProvider

<ul class="navbar-nav align-items-sm-center">
    <li class="nav-item">
        <button type="button" class="btn btn-sm btn-outline-secondary border-0" title="Theme"
                data-bs-toggle="modal" data-bs-target="#themePickerModal">
            <i class="bi bi-palette"></i>
        </button>
    </li>
@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        @{
            var displayName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? User.FindFirst("given_name")?.Value ?? User.Identity?.Name ?? "";
        }
        @if (AuthProvider.IsKeycloak)
        {
            @* Keycloak: link to Keycloak's self-service account console *@
            <a class="nav-link" href="@AuthProvider.KeycloakAccountUrl" target="_blank" rel="noopener" title="Manage account in Keycloak">Hello @displayName!</a>
        }
        else
        {
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @displayName!</a>
        }
    </li>
    <li class="nav-item">
        @if (AuthProvider.IsKeycloak)
        {
            @* Keycloak: POST to AuthController which signs out of both cookie and OIDC session *@
            <form class="form-inline" asp-controller="Auth" asp-action="Logout" asp-area="">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link btn btn-link">Logout</button>
            </form>
        }
        else
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link">Logout</button>
            </form>
        }
    </li>
}
else
{
    <li class="nav-item">
        @if (AuthProvider.IsKeycloak)
        {
            <a class="nav-link" asp-controller="Auth" asp-action="Login" asp-area="" asp-route-returnUrl="@Context.Request.Path">Login</a>
        }
        else
        {
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
        }
    </li>
    @* Keycloak-managed instances create user accounts in Keycloak itself, so self-registration
       only applies to the built-in Identity provider. *@
    @if (AuthProvider.IsIdentity)
    {
        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
    }
}
</ul>
