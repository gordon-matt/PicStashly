<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#375a7f" />
    <title>@ViewData["Title"] - PicStashly</title>
    <script type="importmap"></script>

    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="~/img/Icon.png" />
    <link rel="alternate icon" href="~/favicon.ico" />

    @* Default stylesheet; theme-init.js swaps href from localStorage before first paint. *@
    <link id="theme-stylesheet" rel="stylesheet" href="~/lib/bootswatch/dist/darkly/bootstrap.min.css" />
    <script src="~/js/theme-init.js" asp-append-version="true"></script>

    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css">
        <link rel="stylesheet" href="~/lib/egalink-toasty.js/dist/toasty.css" />
        <link rel="stylesheet" href="~/lib/yaireo/tagify/dist/tagify.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="~/lib/egalink-toasty.js/dist/toasty.min.css" />
        <link rel="stylesheet" href="~/lib/yaireo/tagify/dist/tagify.min.css" />
    </environment>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PicStashly.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm bg-body-tertiary border-bottom box-shadow mb-3" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="navbar-brand-logo navbar-brand-logo-light" src="~/img/Logo.png" alt="PicStashly" height="50" />
                    <img class="navbar-brand-logo navbar-brand-logo-dark" src="~/img/Logo-Light.png" alt="PicStashly" height="50" />
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap"></i> Library
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Upload" asp-action="Index">
                                <i class="bi bi-cloud-arrow-up"></i> Upload
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Tags" asp-action="Index">
                                <i class="bi bi-tags"></i> Tags
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-folder2-open"></i> Categories
                            </a>
                        </li>
                        @if (User.IsInRole(Constants.Roles.Administrator))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-gear"></i> Admin
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/logvue">
                                    <i class="bi bi-journal-text"></i> Logs
                                </a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <span>&copy; @DateTime.Today.Year - PicStashly</span>
            <span class="small text-muted">v@(typeof(Program).Assembly.GetName().Version?.ToString(3))</span>
        </div>
    </footer>

    <partial name="_ThemePicker" />

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
        <script src="~/lib/knockout/build/output/knockout-latest.js"></script>
        <script src="~/lib/yaireo/tagify/dist/tagify.js"></script>
        <script src="~/lib/egalink-toasty.js/dist/toasty.js"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/lib/knockout/build/output/knockout-latest.min.js"></script>
        <script src="~/lib/yaireo/tagify/dist/tagify.min.js"></script>
        <script src="~/lib/egalink-toasty.js/dist/toasty.min.js"></script>
    </environment>

    <script src="~/js/theme-picker.js" asp-append-version="true"></script>

    <script type="text/javascript">
        const toast = new Toasty({
            enableSounds: false
        });

        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
