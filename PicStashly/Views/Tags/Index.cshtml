@{
    ViewData["Title"] = "Tags";
}

<div class="container">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h2>Tags</h2>
            <p class="text-muted mb-0">Rename, merge or delete tags</p>
        </div>
        <div class="col-auto" data-bind="visible: selectedIds().length > 1">
            <button class="btn btn-warning" data-bind="click: openMergeModal">
                <i class="bi bi-union"></i> Merge selected (<span data-bind="text: selectedIds().length"></span>)
            </button>
        </div>
    </div>

    <div data-bind="visible: loading" class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <div data-bind="visible: !loading() && tags().length === 0" class="alert alert-info" style="display: none;">
        <i class="bi bi-info-circle me-2"></i> No tags yet — they'll appear here as you tag images.
    </div>

    <table class="table table-hover align-middle" data-bind="visible: !loading() && tags().length > 0" style="display: none;">
        <thead>
            <tr>
                <th style="width: 40px;"></th>
                <th>Name</th>
                <th class="text-end">Images</th>
                <th class="text-end" style="width: 200px;">Actions</th>
            </tr>
        </thead>
        <tbody data-bind="foreach: tags">
            <tr>
                <td>
                    <input type="checkbox" class="form-check-input"
                           data-bind="checked: $parent.isSelected($data),
                                      event: { click: function () { $parent.toggleSelected($data); return true; } }" />
                </td>
                <td>
                    <!-- ko ifnot: $parent.editingTag() === $data -->
                    <a data-bind="text: name, attr: { href: '/?tags=' + encodeURIComponent(name) }"></a>
                    <!-- /ko -->
                    <!-- ko if: $parent.editingTag() === $data -->
                    <input type="text" class="form-control form-control-sm d-inline-block w-auto"
                           data-bind="value: $parent.editName, valueUpdate: 'afterkeydown',
                                      event: { keyup: function (d, e) { if (e.key === 'Enter') $parent.saveRename(); if (e.key === 'Escape') $parent.cancelRename(); return true; } }" />
                    <!-- /ko -->
                </td>
                <td class="text-end" data-bind="text: usageCount"></td>
                <td class="text-end">
                    <!-- ko ifnot: $parent.editingTag() === $data -->
                    <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.startRename" title="Rename">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteTag" title="Delete">
                        <i class="bi bi-trash"></i>
                    </button>
                    <!-- /ko -->
                    <!-- ko if: $parent.editingTag() === $data -->
                    <button class="btn btn-sm btn-success" data-bind="click: $parent.saveRename" title="Save">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.cancelRename" title="Cancel">
                        <i class="bi bi-x-lg"></i>
                    </button>
                    <!-- /ko -->
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Merge modal -->
<div class="modal fade" id="mergeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Merge tags</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">
                    All selected tags will be merged into the target tag. Images keep their
                    associations; the other tags are deleted.
                </p>
                <label class="form-label">Merge into:</label>
                <select class="form-select"
                        data-bind="options: selectedTags, optionsText: 'name', optionsValue: 'id', value: mergeTargetId">
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" data-bind="click: confirmMerge">
                    <i class="bi bi-union"></i> Merge
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/tags.js" asp-append-version="true"></script>
}
