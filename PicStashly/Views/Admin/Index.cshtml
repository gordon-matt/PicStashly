@using System.Security.Claims
@using PicStashly.Infrastructure
@inject IAuthProviderService AuthProvider
@{
    ViewData["Title"] = "Admin";
    var currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
}

<div class="container">
    <h2 class="mb-4">Admin</h2>

    <!-- Storage stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h3 data-bind="text: formatNumber(stats()?.imageCount)"></h3>
                    <span class="text-muted">Images</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h3 data-bind="text: formatFileSize(stats()?.totalSizeBytes)"></h3>
                    <span class="text-muted">Total size</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h3 data-bind="text: formatNumber(stats()?.tagCount)"></h3>
                    <span class="text-muted">Tags</span>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center h-100">
                <div class="card-body">
                    <h3 data-bind="text: formatNumber(stats()?.untaggedImageCount)"></h3>
                    <span class="text-muted">Untagged</span>
                </div>
            </div>
        </div>
    </div>

    <!-- OCR availability -->
    <div data-bind="visible: stats() && !stats().ocrAvailable" class="alert alert-warning" style="display: none;">
        <i class="bi bi-exclamation-triangle me-1"></i>
        <strong>OCR is unavailable</strong> — PaddleOCR's native stack failed to load, so text
        extraction is being skipped for every upload. Models are bundled with the app, so this is
        almost always a missing system dependency:
        <ul class="mb-2">
            <li><strong>Windows:</strong> install the latest
                <a href="https://aka.ms/vs/17/release/vc_redist.x64.exe" target="_blank" rel="noopener">Visual C++ Redistributable (x64)</a>,
                then restart the app.</li>
            <li><strong>Linux/Docker:</strong> ensure <code>libgomp1</code> is installed (it's already
                added in this app's Docker image).</li>
            <li>If your CPU is old and lacks AVX, set <code>Ocr:Device</code> to <code>Openblas</code>
                in <code>appsettings.json</code>.</li>
        </ul>
        Once it's working, use <strong>Re-run OCR on all images</strong> below to backfill existing uploads.
    </div>

    <!-- Maintenance -->
    <div class="card mb-4">
        <div class="card-header"><i class="bi bi-tools me-1"></i> Maintenance</div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button class="btn btn-outline-primary" data-bind="click: runOrphanCheck, disable: busy">
                    <i class="bi bi-search"></i> Check for orphans / broken files
                </button>
                <button class="btn btn-outline-primary" data-bind="click: runRehash, disable: busy">
                    <i class="bi bi-fingerprint"></i> Re-compute all hashes
                </button>
                <button class="btn btn-outline-primary" data-bind="click: runReOcr, disable: busy">
                    <i class="bi bi-body-text"></i> Re-run OCR on all images
                </button>
                <span data-bind="visible: busy" class="align-self-center text-muted">
                    <span class="spinner-border spinner-border-sm"></span> Working — this can take a while...
                </span>
            </div>

            <div data-bind="visible: maintenanceMessage" class="alert alert-info py-2" style="display: none;">
                <span data-bind="text: maintenanceMessage"></span>
            </div>

            <!-- Orphan check results -->
            <div data-bind="visible: orphanResult() !== null" style="display: none;">
                <!-- ko with: orphanResult -->
                <h6 class="mt-3">Orphaned files (on disk, not in database): <span data-bind="text: orphanedFiles.length"></span></h6>
                <ul class="small" data-bind="foreach: orphanedFiles">
                    <li><code data-bind="text: $data"></code></li>
                </ul>
                <h6>Broken images (in database, file missing): <span data-bind="text: brokenImages.length"></span></h6>
                <ul class="small" data-bind="foreach: brokenImages">
                    <li><a data-bind="attr: { href: '/image/' + id }, text: fileName"></a></li>
                </ul>
                <!-- /ko -->
            </div>
        </div>
    </div>

    @if (AuthProvider.IsIdentity)
    {
        <!-- User management -->
        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-people me-1"></i> Family members</div>
            <div class="card-body">
                <p class="text-muted small">
                    Anyone can register an account, but new accounts start locked — approve them here
                    before they can log in. Each family member's images, tags and categories are
                    private to their own account.
                </p>

                <div data-bind="visible: usersLoading" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading…</span>
                    </div>
                </div>

                <div data-bind="visible: !usersLoading()" style="display: none;">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th>Role</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: users">
                                <tr>
                                    <td>
                                        <span data-bind="text: email"></span>
                                        <!-- ko if: isCurrentUser -->
                                        <span class="badge bg-secondary ms-1">You</span>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <!-- ko if: isPendingApproval -->
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Pending approval</span>
                                        <!-- /ko -->
                                        <!-- ko ifnot: isPendingApproval -->
                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> Active</span>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <!-- ko if: isCurrentUser -->
                                        <span class="badge rounded-pill text-bg-primary" data-bind="text: role()"></span>
                                        <!-- /ko -->
                                        <!-- ko ifnot: isCurrentUser -->
                                        <select class="form-select form-select-sm" style="width:auto;"
                                                data-bind="value: role, event: { change: function (user, evt) { $root.changeUserRole(user, evt); } }">
                                            <option value="Administrator">Administrator</option>
                                            <option value="User">User</option>
                                        </select>
                                        <!-- /ko -->
                                    </td>
                                    <td class="text-end">
                                        <!-- ko if: isPendingApproval -->
                                        <button class="btn btn-sm btn-success" data-bind="click: $root.approveUser">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                        <!-- /ko -->
                                        <!-- ko ifnot: isPendingApproval -->
                                        <button class="btn btn-sm btn-outline-warning" data-bind="click: $root.lockUser, disable: isCurrentUser">
                                            <i class="bi bi-lock"></i> Lock
                                        </button>
                                        <!-- /ko -->
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="text-muted text-center py-2" data-bind="visible: users().length === 0">
                        No users found.
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Bookmarklet -->
    <div class="card mb-4">
        <div class="card-header"><i class="bi bi-bookmark-plus me-1"></i> Bookmarklet</div>
        <div class="card-body">
            <p class="text-muted small">
                Drag this link to your bookmarks bar. Clicking it on any webpage lets you pick an
                image on the page and save it straight into PicStashly (with the page URL recorded
                as the source).
            </p>
            <a id="bookmarkletLink" class="btn btn-outline-primary" href="#">
                <i class="bi bi-images"></i> Stash it!
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.picstashlyCurrentUserId = '@currentUserId';
        window.picstashlyIsIdentityAuth = @(AuthProvider.IsIdentity ? "true" : "false");
    </script>
    <script type="module" src="~/js/admin.js" asp-append-version="true"></script>
}
