{
  "name": "PicStashly",
  "short_name": "PicStashly",
  "description": "Self-hosted image dump for memes and random pictures",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#222222",
  "theme_color": "#375a7f",
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/upload/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
