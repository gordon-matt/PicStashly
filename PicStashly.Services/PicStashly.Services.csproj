<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Ardalis.Result" Version="10.1.0" />
		<PackageReference Include="LinqKit.Core" Version="1.2.11" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="Sdcb.PaddleOCR" Version="3.3.1" />
		<PackageReference Include="Sdcb.PaddleOCR.Models.Local" Version="3.3.1" />
		<PackageReference Include="Sdcb.PaddleInference" Version="3.3.1" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
	</ItemGroup>

	<!--
		PaddleOCR/OpenCvSharp ship platform-specific native libraries. Reference only the ones
		matching the build/publish host OS so Windows dev restores stay lean and the Linux Docker
		image doesn't drag in Windows DLLs. Dev = Windows x64, Docker/prod = Linux x64.
	-->
	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
		<PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
		<PackageReference Include="Sdcb.PaddleInference.runtime.linux-x64.mkl" Version="3.3.1.70" />
		<PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PicStashly.Core\PicStashly.Core.csproj" />
		<ProjectReference Include="..\PicStashly.Data\PicStashly.Data.csproj" />
		<ProjectReference Include="..\PicStashly.Models\PicStashly.Models.csproj" />
	</ItemGroup>

</Project>
